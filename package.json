{
  "name": "iphone-fleet-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "unit": "vitest run --config vitest.unit.config.ts",
    "contract": "vitest run --config vitest.contract.config.ts",
    "integration": "vitest run --config vitest.integration.config.ts",
    "e2e-mock": "vitest run --config vitest.e2e-mock.config.ts",
    "verify": "corepack pnpm build && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm unit && corepack pnpm contract && corepack pnpm e2e-mock",
    "real-ios:e2e": "node -e \"console.error('BLOCKED: macOS Device Lab and real iPhone are required (M0+).'); process.exit(2)\""
  },
  "engines": {
    "node": "24.14.1",
    "pnpm": "11.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
